<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱 테마에서 모든 KineticaBoardView의 기본 스타일을 정하는 테마 속성. -->
    <attr name="kinetica_boardViewStyle" format="reference" />

    <!-- KineticaBoardView XML 속성. 코드에서 이름이 같은 속성과 같은 역할을 한다. -->
    <declare-styleable name="KineticaBoardView">
        <!-- 처음부터 편집 모드로 연다. -->
        <attr name="kinetica_editing" format="boolean" />
        <!-- 0보다 크면 사용 모드에서 위젯 스택이 이 간격(ms)마다 다음 위젯으로 넘어간다. -->
        <attr name="kinetica_stackAutoAdvanceMs" format="integer" />
        <!-- 편집 화면의 강조색. -->
        <attr name="kinetica_accentColor" format="color" />
        <!-- 편집 테두리와 크기 조절 핸들의 모서리 반지름. 위젯 카드의 모서리 반지름과 같게 준다. -->
        <attr name="kinetica_widgetCornerRadius" format="dimension" />
        <!-- 격자 배치에서 칸 폭이 이 값보다 좁아지지 않는 만큼 열을 늘린다. 주지 않으면 열 수를 바꾸지 않는다. -->
        <attr name="kinetica_minCellWidth" format="dimension" />
        <!-- kinetica_minCellWidth로 늘리는 최대 열 수(1..24). 기본 24. -->
        <attr name="kinetica_maxColumns" format="integer" />
    </declare-styleable>
</resources>
