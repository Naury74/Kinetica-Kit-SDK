<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱 테마에서 모든 KineticaBoardView의 기본 스타일을 정하는 테마 속성. -->
    <attr name="kinetica_boardViewStyle" format="reference" />

    <!-- KineticaBoardView XML 속성. 코드에서 이름이 같은 속성과 같은 역할을 한다. -->
    <declare-styleable name="KineticaBoardView">
        <!-- 처음부터 편집 모드로 연다. -->
        <attr name="kinetica_editing" format="boolean" />
        <!-- 0보다 크면 사용 모드에서 위젯 스택이 이 간격(ms)마다 다음 위젯으로 넘어간다. -->
        <attr name="kinetica_stackAutoAdvanceMs" format="integer" />
        <!-- 편집 화면의 강조색. -->
        <attr name="kinetica_accentColor" format="color" />
    </declare-styleable>
</resources>
