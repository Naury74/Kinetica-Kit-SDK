<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Consumer" android:allowBackup="false" android:theme="@style/Theme.Consumer">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".BoardActivity" android:exported="false" />
        <activity android:name=".SurfaceActivity" android:exported="false" />
        <activity android:name=".XmlSurfaceActivity" android:exported="false" />
        <activity android:name=".m3.M3EdgeActivity" android:exported="true" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".m3.M3NoEdgeActivity" android:exported="false" />
        <activity android:name=".xml.XmlHostActivity" android:exported="true" />
        <activity android:name=".JavaHostActivity" android:exported="false" />
        <activity android:name=".xml.XmlComposeActivity" android:exported="true" />
        <!-- 키보드 처리 방식별 확인용. 기기에서 adb로 바로 열 수 있게 노출한다(시험 앱 전용). -->
        <activity android:name=".m3.M3PanActivity" android:exported="true" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".xml.XmlPanActivity" android:exported="true" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".xml.XmlEdgeActivity" android:exported="true" />
        <activity android:name=".xml.XmlNothingActivity" android:exported="true" android:windowSoftInputMode="adjustNothing" />
        <!-- 최근 추가 API 시나리오: 시스템 바 아이콘, 넓은 화면, 열 수가 바뀌는 보드, 편집기 -->
        <activity android:name=".recent.BarIconsActivity" android:exported="false" />
        <activity android:name=".recent.BarIconsScaffoldActivity" android:exported="false" />
        <activity android:name=".recent.WideHostActivity" android:exported="false" />
        <activity android:name=".recent.AdaptiveBoardActivity" android:exported="false" />
        <activity android:name=".recent.XmlAdaptiveBoardActivity" android:exported="false" />
        <activity android:name=".recent.EditorHostActivity" android:exported="false" />
    </application>
</manifest>
