<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xml_background">

<!-- 좁은 화면에서는 보드와 서버 장면을 한 화면에 다 담지 못하므로 화면 전체를 스크롤한다.
     보드는 높이 제한이 없으면 위젯 내용만큼 커지고, 편집 중 끌기는 이 스크롤 안에서도 자동 스크롤된다. -->
<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 제목 줄. 뒤로 버튼의 꺾쇠가 아래 설명 글과 같은 세로선에서 시작하도록 버튼을 바깥으로 조금 뺀다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="뒤로"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_xml_back"
            android:tint="@color/xml_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="XML 레이아웃 화면"
            android:textColor="@color/xml_title"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Compose 코드 없이 KineticaBoardView, KineticaPlayerView, GlassSurfaceView를 레이아웃 XML에 넣고, 글래스 시트와 다이얼로그, 토스트는 코드 한 줄로 띄웁니다."
        android:textColor="@color/xml_body"
        android:textSize="13sp" />

    <!-- 글래스 창 버튼. 모양은 XmlActivity.stylePill에서 캡슐로 칠하고, 같은 폭으로 줄을 채운다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/glass_sheet"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="시트" />

        <Button
            android:id="@+id/glass_dialog"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="다이얼로그" />

        <Button
            android:id="@+id/glass_toast"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="토스트" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 보드 제목과 편집 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="위젯 보드"
                android:textColor="@color/xml_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/edit"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="72dp"
                android:paddingHorizontal="18dp"
                android:text="편집" />
        </LinearLayout>

        <!-- 보드는 가장자리에 12dp 간격을 두므로 그만큼 바깥으로 넓혀 위젯 가장자리를 버튼 줄과 맞춘다.
             음수 여백은 layout_marginHorizontal로 주면 무시되므로 Start/End로 준다. -->
        <com.naury.kinetica.board.KineticaBoardView
            android:id="@+id/board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"
            app:kinetica_accentColor="#5B6CFF"
            app:kinetica_widgetCornerRadius="20dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="서버에서 받은 화면"
        android:textColor="@color/xml_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 장면을 화면 폭에 맞춰 펼친다(responsive). 높이는 매출 카드 높이(약 240dp)에 맞췄다.
         장면 안쪽에 16dp 여백이 있어 그만큼 바깥으로 넓혀 카드 가장자리를 버튼 줄과 맞춘다. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="244dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp">

        <com.naury.kinetica.player.KineticaPlayerView
            android:id="@+id/promo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:kinetica_fit="responsive" />

            <!-- 뒤에 그려진 재생기 화면을 블러 처리해 비추는 글래스 태그. 서버에서 받은 장면이라는 것을 알려 준다. -->
            <com.naury.kinetica.ui.view.GlassSurfaceView
                android:id="@+id/promo_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="36dp"
                app:kinetica_cornerRadius="14dp"
                app:kinetica_glassStyle="liquid">

                <TextView
                    android:id="@+id/promo_caption_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="실시간"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.naury.kinetica.ui.view.GlassSurfaceView>
    </FrameLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- 스크롤한 내용이 상태 표시줄 아래로 비치지 않게 덮는 막. 높이는 XmlActivity가 상태 표시줄 높이로 맞춘다. -->
    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:alpha="0.94"
        android:background="@color/xml_background" />
</FrameLayout>
