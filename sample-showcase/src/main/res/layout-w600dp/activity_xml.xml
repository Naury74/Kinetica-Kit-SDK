<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xml_background">

<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 제목 줄. 뒤로 버튼의 꺾쇠가 아래 설명 글과 같은 세로선에서 시작하도록 버튼을 바깥으로 조금 뺀다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="뒤로"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_xml_back"
            android:tint="@color/xml_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="XML 레이아웃 화면"
            android:textColor="@color/xml_title"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Compose 코드 없이 KineticaBoardView, KineticaPlayerView, GlassSurfaceView를 레이아웃 XML에 넣고, 글래스 시트와 다이얼로그, 토스트는 코드 한 줄로 띄웁니다."
        android:textColor="@color/xml_body"
        android:textSize="13sp" />

    <!-- 글래스 창 버튼. 모양은 XmlActivity.stylePill에서 캡슐로 칠하고, 같은 폭으로 줄을 채운다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/glass_sheet"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="시트" />

        <Button
            android:id="@+id/glass_dialog"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="다이얼로그" />

        <Button
            android:id="@+id/glass_toast"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="토스트" />
    </LinearLayout>

    <!-- 넓은 화면(폭 600dp 이상): 왼쪽에 보드, 오른쪽에 홍보 장면 전체를 둔다. baselineAligned를 끄지 않으면 기준선을 재려고
         보드를 폭 제한 없이 한 번 더 측정한다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 보드 제목과 편집 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="위젯 보드"
                    android:textColor="@color/xml_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/edit"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="72dp"
                    android:paddingHorizontal="18dp"
                    android:text="편집" />
            </LinearLayout>

            <!-- 보드 가장자리 간격(12dp)만큼 바깥으로 넓혀 위젯 끝을 제목 줄과 맞춘다. -->
            <com.naury.kinetica.board.KineticaBoardView
                android:id="@+id/board"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="-12dp"
                android:layout_marginEnd="-12dp"
                android:layout_weight="1"
                app:kinetica_accentColor="#5B6CFF"
                app:kinetica_widgetCornerRadius="20dp" />
        </LinearLayout>

        <!-- 오른쪽 칸. 제목 줄 높이를 왼쪽과 맞추고, 장면 안쪽 여백(16dp)만큼 재생기를 바깥으로 넓혀 카드 끝을 제목과 맞춘다. -->
        <LinearLayout
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:text="홍보 화면"
                android:textColor="@color/xml_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp">

                <com.naury.kinetica.player.KineticaPlayerView
                    android:id="@+id/promo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:kinetica_fit="responsive" />

                <!-- 뒤에 그려진 재생기 화면을 블러 처리해 비추는 글래스 태그. 서버에서 받은 장면이라는 것을 알려 준다. -->
                <com.naury.kinetica.ui.view.GlassSurfaceView
                    android:id="@+id/promo_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="36dp"
                    app:kinetica_cornerRadius="14dp"
                    app:kinetica_glassStyle="liquid">

                    <TextView
                        android:id="@+id/promo_caption_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="서버 장면"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.naury.kinetica.ui.view.GlassSurfaceView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
